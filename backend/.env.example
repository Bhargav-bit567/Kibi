# Kibi server configuration
# Copy this file to .env for local development. In production (Vercel/Render),
# add the same variables in the hosting dashboard. Never commit real secrets.

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers).
# Include the database name, e.g. ...mongodb.net/kibi?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kibi?retryWrites=true&w=majority

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Local port (ignored on Vercel)
PORT=3000

# Only needed if the frontend is hosted on a different domain than the API
# (comma-separated origins, e.g. https://kibi.example.com)
CORS_ORIGINS=

# Continue with Google: OAuth "Web application" client from Google Cloud Console
# (see README → "Continue with Google"). Both values are needed; if either is
# empty, the Google button tells users it isn't set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: full callback URL if the default (<your site>/api/auth/google/callback) doesn't fit
GOOGLE_CALLBACK_URL=

# Kibi AI chatbot + AI itineraries: Gemini API key from https://aistudio.google.com/apikey
# It stays on the server; the browser talks to /api/ai/generate.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.5-flash-lite)
GEMINI_MODEL=


# Emails on sign-up (welcome) and sign-in (alert).
# Option A (recommended, works on Render's free plan): Brevo API key from
# https://app.brevo.com → SMTP & API → API Keys. MAIL_FROM must be a sender you verified in Brevo.
BREVO_API_KEY=
# Option B: SMTP. Gmail example — use an App Password
# (Google Account → Security → 2-Step Verification → App passwords), not your normal password.
# Leave SMTP_HOST empty to turn emails off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Kibi <your.address@gmail.com>
# Public address used for links inside emails (e.g. https://kibi-mu.vercel.app)
SITE_URL=
