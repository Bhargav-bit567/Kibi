{
  "version": 2,
  "builds": [
    {
      "src": "backend/vercel.js",
      "use": "@vercel/node",
      "config": {
        "excludeFiles": [
          "frontend/**"
        ]
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/vercel.js"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
